# Razorpay Test Mode Credentials
# Get your test key ID & Secret from Razorpay Dashboard -> Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere

# Server Configuration
PORT=8000
HOST=127.0.0.1

# LLM Provider Configuration (Optional)
# If provided, real LLM function calling will be used.
# If omitted, PayAgent uses its built-in zero-dependency autonomous decision engine!
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
